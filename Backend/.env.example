# Copy this file to .env and fill in the values.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/iiits_sports

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long an admin stays signed in.
JWT_EXPIRES_IN=1d

# Frontend address(es) allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Set to true when the API runs behind a reverse proxy (Nginx, Render, Railway...).
TRUST_PROXY=false
