# Copy this file to .env and adjust as needed.

# Backend address. Leave it empty during development: Vite forwards /api to http://localhost:4000.
# Set it when the frontend and backend are deployed separately, e.g. https://sports-api.example.com
VITE_API_URL=

# Unlisted path of the admin sign-in page. VITE_ variables end up in the browser bundle,
# so this only hides the page; the admin password is what actually protects it.
VITE_ADMIN_PATH=/control-room

# Google sign-in for players and referees: the OAuth client ID from Google Cloud Console,
# the same value as GOOGLE_CLIENT_ID in Backend/.env. It is public (it ends up in the page).
VITE_GOOGLE_CLIENT_ID=
